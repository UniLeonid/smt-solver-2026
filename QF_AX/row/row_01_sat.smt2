(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select (store (store B j i) i i) j) b))
(assert (let ((a!1 (select (store (store (store B k c) i c) j b) i)))
  (= a!1 b)))
(assert (distinct j k))
(assert (distinct j k))
(assert (distinct (select (store B k a) i) b))
(check-sat)
(exit)
