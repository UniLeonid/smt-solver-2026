(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= i j))
(assert (distinct k j))
(assert (distinct (select (store B k b) j) c))
(assert (= (select (store B i c) k) (select (store B j i) i)))
(assert (= (select (store A j c) i) b))
(assert (= (select (store A j a) i) c))
(check-sat)
(exit)
