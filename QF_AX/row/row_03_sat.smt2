(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (let ((a!1 (select (store (store (store A j i) j b) k b) j)))
  (= a!1 b)))
(assert (let ((a!1 (select (store (store (store B k i) i i) j a) i)))
  (= a!1 c)))
(assert (= (select (store (store B j c) j i) k) b))
(assert (distinct j i))
(assert (= (select (store B k c) j) (select (store B i i) j)))
(check-sat)
(exit)
