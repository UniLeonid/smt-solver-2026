(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select (store A i a) (select A k)) a))
(assert (distinct (select (store (store A i b) k c) j) c))
(assert (let ((a!1 (select (store (store (store A k a) i i) k a) k)))
  (= a!1 (select (store B i a) (select B i)))))
(assert (= (select (store A k c) j) a))
(assert (distinct i j))
(assert (distinct b a))
(check-sat)
(exit)
