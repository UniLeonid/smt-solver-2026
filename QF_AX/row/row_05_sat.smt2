(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct k j))
(assert (distinct c a))
(assert (= (select (store (store B j i) k i) i) (select (store A k a) k)))
(assert (distinct c b))
(assert (= (select (store (store A i a) i i) j) a))
(check-sat)
(exit)
