(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select (store (store A j i) k a) (select B i)) c))
(assert (distinct (select (store A i c) i) a))
(assert (distinct j i))
(assert (distinct k j))
(assert (let ((a!1 (select (store (store (store B k a) j c) k c) (select A k))))
  (distinct a!1 (select A (select B j)))))
(assert (distinct j i))
(check-sat)
(exit)
