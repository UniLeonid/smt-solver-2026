(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct (select (store B i i) j) c))
(assert (distinct i j))
(assert (distinct (select (store B j a) i) b))
(assert (let ((a!1 (select (store (store (store B j c) i a) j b) j)))
  (= a!1 a)))
(check-sat)
(exit)
