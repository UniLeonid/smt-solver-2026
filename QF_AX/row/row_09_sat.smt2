(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status sat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select (store (store A k b) k b) j) c))
(assert (let ((a!1 (select (store (store (store B j a) k a) k a) k)))
  (= a!1 (select (store A j a) i))))
(assert (= k i))
(assert (distinct (select (store (store A i a) k b) k) c))
(check-sat)
(exit)
