(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct (select (store B i b) k) (select (store B j i) k)))
(assert (distinct c a))
(assert (distinct i j))
(assert (distinct j k))
(assert (distinct (select (store A i a) i) a))
(check-sat)
(exit)
