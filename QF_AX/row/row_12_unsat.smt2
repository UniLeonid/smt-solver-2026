(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select (store (store A k a) k a) k) c))
(assert (= k i))
(assert (= j k))
(assert (let ((a!1 (select (store (store (store A j a) j b) i i) k)))
  (= a!1 b)))
(assert (distinct a c))
(assert (= (select (store (store B j c) i c) i) (select (store A i i) i)))
(check-sat)
(exit)
