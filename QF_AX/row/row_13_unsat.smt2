(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct i j))
(assert (distinct (select (store (store B k b) k b) j) b))
(assert (distinct j i))
(assert (distinct c b))
(assert (= (select (store B j b) j) c))
(assert (= (select (store B i c) j) a))
(check-sat)
(exit)
