(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct c b))
(assert (distinct j i))
(assert (= (select A j) c))
(assert (let ((a!1 (select (store (store (store A j a) k b) k a) i)))
  (= a!1 (select A i))))
(assert (let ((a!1 (select (store (store (store A i a) j b) k a) i)))
  (= a!1 a)))
(assert (let ((a!1 (select (store (store (store A k c) j c) i b) i)))
  (= a!1 c)))
(check-sat)
(exit)
