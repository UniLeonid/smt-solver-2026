(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct (select A j) (select (store B j a) (select A i))))
(assert (distinct c a))
(assert (= (select (store A k i) (select B j)) (select (store A i c) j)))
(assert (distinct (select (store (store B i c) j c) i) c))
(check-sat)
(exit)
