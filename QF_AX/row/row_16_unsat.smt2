(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= k j))
(assert (let ((a!1 (select (store (store (store A k a) j a) j i) i)))
  (distinct a!1 a)))
(assert (distinct (select (store B j c) j) c))
(assert (= i k))
(assert (let ((a!1 (select (store (store (store B j a) i c) j a) (select A i))))
  (distinct a!1 a)))
(assert (= (select (store (store B i i) i a) (select A j)) c))
(check-sat)
(exit)
