(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct b a))
(assert (= (select (store (store A j b) k c) j) a))
(assert (distinct c b))
(assert (let ((a!1 (select (store (store (store B k i) k b) j c) j)))
  (= a!1 c)))
(assert (= (select (store B j a) j) b))
(check-sat)
(exit)
