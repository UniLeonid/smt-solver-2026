(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (= (select A i) (select (store A j b) (select A j))))
(assert (distinct k j))
(assert (distinct b c))
(assert (distinct (select B j) (select (store B k b) k)))
(assert (distinct j i))
(assert (distinct (select (store (store B j b) i c) i) c))
(check-sat)
(exit)
