(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |Read-over-write formulas without array equalities, generated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort S 0)
(declare-fun i () S)
(declare-fun j () S)
(declare-fun k () S)
(declare-fun a () S)
(declare-fun b () S)
(declare-fun c () S)
(declare-fun A () (Array S S))
(declare-fun B () (Array S S))
(assert (distinct i j))
(assert (distinct i k))
(assert (distinct (select (store (store A i a) j a) k) a))
(assert (distinct (select (store (store A j a) j b) j) b))
(assert (let ((a!1 (select (store (store (store B i i) i c) i c) k)))
  (distinct a!1 a)))
(check-sat)
(exit)
