(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |QF_AX/storeinv/storeinv_t2_np_nf_ai_00001_001.cvc.smt2 (Armando et al., PDPAR 2005), array equalities eliminated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort Element 0)
(declare-sort Index 0)
(declare-fun a1 () (Array Index Element))
(declare-fun a2 () (Array Index Element))
(declare-fun i1 () Index)
(declare-fun k0 () Index)
(assert (distinct (select a1 k0) (select a2 k0)))
(assert (= (select (store a1 i1 (select a2 i1)) k0)
   (select (store a2 i1 (select a1 i1)) k0)))
(assert (= (select (store a1 i1 (select a2 i1)) i1)
   (select (store a2 i1 (select a1 i1)) i1)))
(check-sat)
(exit)
