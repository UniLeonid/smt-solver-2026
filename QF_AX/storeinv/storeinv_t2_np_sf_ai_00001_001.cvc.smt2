(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |QF_AX/storeinv/storeinv_t2_np_sf_ai_00001_001.cvc.smt2 (Armando et al., PDPAR 2005), array equalities eliminated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort Element 0)
(declare-sort Index 0)
(declare-fun a1 () (Array Index Element))
(declare-fun a2 () (Array Index Element))
(declare-fun e_0 () Element)
(declare-fun e_2 () Element)
(declare-fun i1 () Index)
(declare-fun k0 () Index)
(assert (= e_0 (select a2 i1)))
(assert (= e_2 (select a1 i1)))
(assert (distinct (select a1 k0) (select a2 k0)))
(assert (= (select (store a1 i1 e_0) i1) (select (store a2 i1 e_2) i1)))
(assert (= (select (store a1 i1 e_0) k0) (select (store a2 i1 e_2) k0)))
(check-sat)
(exit)
