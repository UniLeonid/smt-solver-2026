(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |QF_AX/swap/swap_t2_np_nf_ai_00003_002.cvc.smt2 (Armando et al., PDPAR 2005), array equalities eliminated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort Element 0)
(declare-sort Index 0)
(declare-fun a1 () (Array Index Element))
(declare-fun i0 () Index)
(declare-fun i2 () Index)
(declare-fun k0 () Index)
(assert (let ((a!1 (store (store a1 i0 (select a1 i0)) i0 (select a1 i0))))
(let ((a!2 (store (store a!1 i0 (select a!1 i2)) i2 (select a!1 i0)))
      (a!4 (store (store a!1 i2 (select a!1 i0)) i0 (select a!1 i2))))
(let ((a!3 (select (store (store a!2 i2 (select a!2 i2)) i2 (select a!2 i2)) k0))
      (a!5 (select (store (store a!4 i2 (select a!4 i2)) i2 (select a!4 i2)) k0)))
  (distinct a!3 a!5)))))
(check-sat)
(exit)
