(set-info :smt-lib-version 2.6)
(set-logic QF_AX)
(set-info :source |QF_AX/swap/swap_t2_np_sf_ai_00002_001.cvc.smt2 (Armando et al., PDPAR 2005), array equalities eliminated for the ITMO logic course.|)
(set-info :status unsat)
(declare-sort Element 0)
(declare-sort Index 0)
(declare-fun a1 () (Array Index Element))
(declare-fun e_29 () Element)
(declare-fun e_32 () Element)
(declare-fun i0 () Index)
(declare-fun i1 () Index)
(declare-fun k0 () Index)
(assert (= e_29 (select a1 i1)))
(assert (= e_32 (select (store (store a1 i1 e_29) i1 e_29) i0)))
(assert (let ((a!1 (store (store (store (store a1 i1 e_29) i1 e_29) i0 e_32) i0 e_32)))
  (distinct (select a!1 k0) (select a!1 k0))))
(check-sat)
(exit)
